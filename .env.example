# Copie a .env y ajuste. NUNCA suba .env al repositorio (está en .gitignore).
# Todos los valores de este ejemplo son FICTICIOS.

# --- Servicio ---
NODE_ENV=development
PORT=8080
# all = API + despachador | api = solo API | worker = solo despachador (Cloud Run: servicios separados)
APP_ROLE=all
RUN_MIGRATIONS_ON_START=true
LOG_LEVEL=info
LOG_PRETTY=true
# Origenes permitidos para un frontend (p.ej. React), separados por coma. Vacío = CORS deshabilitado.
CORS_ORIGINS=

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://tracking_notifier:cambiar_password@localhost:5432/tracking_notifier
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Webhooks ---
# 32 bytes aleatorios en base64:  openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=REEMPLAZAR_CON_32_BYTES_BASE64
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=2000
WEBHOOK_RETRY_MAX_DELAY_MS=60000
# Solo en local (receptores en localhost/red docker). En producción: false / true.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
WEBHOOK_REQUIRE_HTTPS=false

# --- Despachador (outbox) ---
DISPATCHER_POLL_INTERVAL_MS=1000
DISPATCHER_BATCH_SIZE=20
DISPATCHER_LEASE_MS=30000

# --- Pruebas de integración / E2E (PostgreSQL real) ---
DATABASE_URL_TEST=postgresql://tracking_notifier:cambiar_password@localhost:5432/tracking_notifier_test

# --- GCP (opcional): enlaza logs con Cloud Trace ---
GOOGLE_CLOUD_PROJECT=
