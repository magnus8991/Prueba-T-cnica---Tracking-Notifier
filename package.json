{
    "name":  "tracking-notifier",
    "version":  "1.0.0",
    "description":  "Microservicio multi-tenant que registra eventos de estado de guÃƒÂ­as y notifica a webhooks de clientes (outbox + reintentos).",
    "private":  true,
    "license":  "UNLICENSED",
    "engines":  {
                    "node":  "\u003e=24"
                },
    "scripts":  {
                    "build":  "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/infrastructure/persistence/migrations','dist/infrastructure/persistence/migrations',{recursive:true})\"",
                    "start":  "node dist/main.js",
                    "start:dev":  "tsx watch --env-file-if-exists=.env src/main.ts",
                    "migrate":  "node dist/infrastructure/persistence/migrate.js",
                    "migrate:dev":  "tsx --env-file-if-exists=.env src/infrastructure/persistence/migrate.ts",
                    "lint":  "eslint .",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "format":  "prettier --write .",
                    "test":  "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
                    "test:unit":  "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects unit architecture",
                    "test:integration":  "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
                    "test:e2e":  "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --selectProjects e2e --runInBand",
                    "test:cov":  "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand --coverage",
                    "test:smoke":  "node scripts/smoke-test.mjs"
                },
    "dependencies":  {
                         "@nestjs/common":  "12.5.1",
                         "@nestjs/core":  "12.5.1",
                         "@nestjs/platform-express":  "12.5.1",
                         "@nestjs/swagger":  "12.1.2",
                         "nestjs-pino":  "5.3.2",
                         "pg":  "8.23.1",
                         "pino":  "10.4.0",
                         "pino-http":  "11.0.0",
                         "prom-client":  "15.1.3",
                         "reflect-metadata":  "0.2.2",
                         "rxjs":  "7.8.2",
                         "yaml":  "2.9.1",
                         "zod":  "4.6.7"
                     },
    "devDependencies":  {
                            "@eslint/js":  "10.0.1",
                            "@types/express":  "5.0.6",
                            "@types/jest":  "30.0.0",
                            "@types/node":  "26.6.6",
                            "@types/pg":  "8.23.1",
                            "@types/supertest":  "7.2.1",
                            "eslint":  "10.15.0",
                            "globals":  "17.14.0",
                            "jest":  "30.5.2",
                            "pino-pretty":  "13.2.0",
                            "prettier":  "3.10.1",
                            "supertest":  "7.3.2",
                            "ts-jest":  "29.4.15",
                            "tsx":  "4.23.15",
                            "typescript":  "6.0.3",
                            "typescript-eslint":  "8.73.0"
                        }
}
